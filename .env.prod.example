# Copy to .env.prod (gitignored) and fill in real values before deploying.
# Never commit .env.prod.

PORT=3000

# Docker's own ENV already sets this, but compose's env_file wins over the
# image, so pin it here too: several behaviours key off it. In production the
# output store defaults to /data/outputs and a missing PUBLIC_BASE_URL is a
# fatal boot error instead of a localhost fallback. Anything other than
# "production" turns both of those into dev-friendly guesses.
NODE_ENV=production

# ---------------------------------------------------------------------------
# Auth — OPTIONAL.
#
# LEAVE EMPTY and this server is FULLY PUBLIC: no key, no accounts, anyone
# who knows the URL can call every tool. That is the intended deployment.
# The service logs "auth: DISABLED" once at boot so this is never a surprise.
#
# Set it to a shared secret and every /mcp request must send it as
#   x-api-key: <token>            or
#   Authorization: Bearer <token>
# GET / (health) and GET /files/:token (downloads) stay public either way —
# a download link has to be followable by a browser tab with no headers.
# Generate one with:
#   openssl rand -hex 32
# (or, if you are on a machine with node rather than the deploy box:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Switching auth on is exactly this one variable plus a restart.
MCP_API_KEY=

# ---------------------------------------------------------------------------
# The public URL callers reach this service at — the base for every
# GET /files/:token download link a large or multi-file tool result returns.
#
# The MCP server is co-hosted with the website and published as a PATH on the
# existing canonical host, not a subdomain: the website's nginx proxies
# /mcp-tools/* here and strips the prefix. So this is the OUTSIDE address,
# including that prefix — not the container's own address.
#
# WARNING: a wrong value here is invisible. Tool calls still succeed; the
# caller just receives a link that resolves to nothing, and nobody finds out
# until they try to download. With NODE_ENV=production an empty value is a
# fatal boot error rather than a silent http://localhost:3000 fallback —
# a crash loop is a much cheaper way to learn this than dead links are.
PUBLIC_BASE_URL=https://goaichat.app/mcp-tools

# ---------------------------------------------------------------------------
# Comma-separated browser Origins allowed to call this service.
#
# EMPTY MEANS ANY ORIGIN, which is the right default for a public server —
# browser-based MCP clients are legitimate callers here. Set a list to
# restrict to exactly those; anything else then gets a 403.
# e.g. MCP_ALLOWED_ORIGINS=https://goaichat.app,https://claude.ai
MCP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Rate limiting — deliberately generous.
#
# The limit that actually protects this 1 GB / 1 shared-vCPU box is
# bytes-and-seconds per call (MAX_INPUT_BYTES and the per-tool bounds), not
# requests per minute. This ceiling exists only so a trivial flood cannot pin
# the single vCPU. Per client, where "client" is CF-Connecting-IP when the
# request came through Cloudflare and req.ip otherwise.
MCP_RATE_LIMIT_MAX=1200
MCP_RATE_LIMIT_WINDOW_MS=60000

# How many reverse proxies sit between this app and the real client, counted
# from the app outward. Production is Cloudflare -> the website's nginx ->
# this app, so 2; the dev compose has only its own nginx sidecar, so 1.
# Too low and req.ip resolves to a Cloudflare edge address (every visitor
# through that PoP shares one rate-limit bucket and one log line).
MCP_TRUST_PROXY_HOPS=2

# ---------------------------------------------------------------------------
# Decoded-bytes cap on any base64 file a tool accepts.
#
# Left commented out on purpose: the tuned value for this box lives in
# utils/byteLimits.js, alongside the per-tool bounds it has to agree with.
# Uncomment only to override it, and do the arithmetic first — HTTP overhead
# before a tool even starts runs about 3.7x the decoded size (raw body ->
# JSON string -> Buffer, all live at once), on top of a ~40 MB idle container
# (measured anon memory on the real image; the 140 MB figure that used to be
# quoted here was a macOS RSS reading), inside a 400 MB container limit.
# 30 MB here is what the old default was and it does not fit.
# MAX_INPUT_BYTES=8000000

# Above this many bytes, a binary tool result is written to disk and
# returned as a download link instead of inlined in the response.
INLINE_OUTPUT_THRESHOLD_BYTES=4000000

# How long a generated file link stays fetchable before the sweep deletes it.
# (A link is also deleted the first time it is downloaded, whichever is
# sooner.)
OUTPUT_TTL_MS=3600000

# Where generated files are written. Must match the path the image creates
# node-owned and docker-compose.prod.yml mounts the tool_outputs volume at,
# or output lands in the container's ephemeral writable layer instead.
# An output does NOT need to survive a redeploy; everything here is
# disposable and expires on its own TTL.
OUTPUT_STORE_DIR=/data/outputs

# Hard ceiling on everything in that directory at once. The TTL bounds how
# LONG a file lives, not how much lives at once — and this endpoint is public
# and unauthenticated on a box whose 25 GB disk also holds the website, so
# without a cap a stranger can fill the disk the site is served from. When
# the cap is reached the store evicts oldest-first; a single file bigger than
# the whole budget fails that tool call instead. 2 GB is ~8% of the disk and
# leaves >20 GB free next to the ~69 MB site and the container images.
OUTPUT_STORE_MAX_BYTES=2000000000

# ---------------------------------------------------------------------------
# Shared outbound-request budget for the appstore_* tools that call Apple's
# public iTunes Search/Lookup API, so concurrent MCP calls can't collectively
# get this service rate-limited or blocked by Apple.
ITUNES_MAX_CONCURRENT=4

# ---------------------------------------------------------------------------
# The heavy-tool concurrency gate (utils/heavyGate.js).
#
# ALL THREE ARE LEFT COMMENTED OUT ON PURPOSE: the defaults below ARE the
# production policy, so an unset environment is the correct one. One
# memory-heavy tool call at a time, server-wide, and a second one refused in
# milliseconds rather than queued. Two concurrent worst-case calls OOM-kill
# this container (measured, exit 137), and queueing spends the caller's own
# budget before their work starts — a wait long enough to be worth having
# pushes the run after it past Cloudflare's 125 s hang-up.
#
# Raise MCP_HEAVY_QUEUE_WAIT_MS above 0 only on a quieter box, and keep
# wait + the tool's own worst run comfortably under 125 s.
# MCP_HEAVY_MAX_CONCURRENT=1
# MCP_HEAVY_QUEUE_WAIT_MS=0
# MCP_HEAVY_QUEUE_DEPTH=4
