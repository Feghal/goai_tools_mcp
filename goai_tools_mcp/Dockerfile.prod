# goai_tools_mcp/Dockerfile.prod
# multi-stage build for small production image
FROM node:20-alpine AS build

WORKDIR /app

# install build deps (cache package.json first)
COPY package.json package-lock.json* ./

# sharp and @napi-rs/canvas both ship prebuilt linux-x64-musl binaries, so
# `npm ci` never needs to compile anything on Alpine — no python3/make/g++.
# If a future dependency here DOES need node-gyp, add the standard
# `apk add --no-cache python3 make g++` line before this RUN.
RUN if [ -f package-lock.json ]; then \
      npm ci --omit=dev; \
    else \
      npm install --omit=dev; \
    fi

# copy source
COPY . .

# final runtime image (use smaller base)
FROM node:20-alpine AS runtime
WORKDIR /app

# create non-root user (node image already has node user)
USER node

# copy node_modules and app from build stage
COPY --from=build --chown=node:node /app ./

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

# optional: add curl for healthchecks (alpine)
USER root
RUN apk add --no-cache curl && chown -R node:node /app
# Generated-file records live here (OUTPUT_STORE_DIR). Creating it node-owned
# in the image matters: Docker seeds a new empty named volume from the image
# path, ownership included, so the non-root runtime user can actually write
# to it.
RUN mkdir -p /data/outputs && chown -R node:node /data
USER node

# default entrypoint
COPY --chown=node:node entrypoint.prod.sh /app/entrypoint.prod.sh
RUN chmod +x /app/entrypoint.prod.sh

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD curl -f http://127.0.0.1:${PORT:-3000}/ || exit 1

CMD ["/app/entrypoint.prod.sh"]
